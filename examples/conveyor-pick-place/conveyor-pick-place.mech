al so the conveyor moves on.</p>"}}],"geometry":{"g1":"","g2":"","g4":"","g3":"","g5":"H4sIAAAAAAAAE3WQwQ2AMAwDLbbiwyd5MBa71YOBhFBax/ys6NJcjWsnsA3gJN4cT07UfM4zs/I4iqn8zf+YEIbm1pDd1aff6rvds//Re6bpJMTf9aBMmt7Un+Z97Yo34v26+bABAAA=","g9":"","g8":"","g13":"H4sIAAAAAAAAE2NgAAHBwwwHzI+AmQz7DjE4aEPZQHFkNrIadPUNOkfgamBsuDguNcjiyGYi24VsDhb3YNiFRS+GO7H4EZs70fUi+x3DzVj8gmEXFj9iuBlZL1pYAdkAkqrnQLABAAA=","g15":"H4sIAAAAAAAAE2NgAIF9TgwHzI+AmQyCzgwO2lA2UByZjawGXX2DzhG4GhgbLo5LDbI4spnIdiGbg8U9GHZh0YvhTix+xOZOdL3IfsdwMxa/YNiFxY8YbkbWixZWQDYAOSKAz7ABAAA=","g12":"","g6":"","g17":"H4sIAAAAAAAAE2NgAAHBwwwO2i5gJsO+QwwHzKFsoDgyG1kNuvoGnSNwNTA2XByXGmRxZDOR7UI2B4t7MOzCohfDnVj8iM2d6HqR/Y7hZix+wbALix8x3IysFy2sgGwAiUlxHrABAAA=","g19":"H4sIAAAAAAAAE2NgAIF9TgwO2i5gJoOgM8MBcygbKI7MRlaDrr5B5whcDYwNF8elBlkc2Uxku5DNweIeDLuw6MVwJxY/YnMnul5kv2O4GYtfMOzC4kcMNyPrRQsrIBsAIsEWkbABAAA=","g7":"","g21":"H4sIAAAAAAAAE2NgKDjMwMB+mKHB8AgDmH3pEJDtwoAQR2Yjq0FT346kph1JbzseNcjiyGYi24VsDjb3oNuFTS+6O7H5Eas7XTDDBOZOdDdj8wu6Xdj8iO5mZL0YYXUEACLlc3uwAQAA","g22":"H4sIAAAAAAAAE2NgKDjMwHDJiaHB8AgDmM3uDGS7MCDEkdnIatDUtyOpaUfS245HDbI4spnIdiGbg8096HZh04vuTmx+xOpOF8wwgbkT3c3Y/IJuFzY/orsZWS9GWB0BAM1ZdiywAQAA","g11":"","g10":"","g14":"","g16":"","g18":"","g20":"","g23":"","g25":"H4sIAAAAAAAAE2NgCDrMwMBzmAEMtA4zMJw4hGDDxIPQ2MhqYGyomgZDF7heOBuoBsxGV4MsjqYGww3IZmJRg9V8XP6C2YVFDS73Y/g9CE09HnFkP2INT2T3YwtPhJkAcXoUdrABAAA=","g26":"H4sIAAAAAAAAE2NgCDrMwHDCiQEMtA4zMPA4I9gw8SA0NrIaGBuqpsHQBa4XzgaqAbPR1SCLo6nBcAOymVjUYDUfl79gdmFRg8v9GH4PQlOPRxzZj1jDE9n92MITYSYAzgqLi7ABAAA=","g28":"H4sIAAAAAAAAE2Ng0HJmYDjhxAAGQc4MDDzOCDZMXAuNjawGxoaqaTB0geuFs4FqwGx0NcjiaGow3IBsJhY1WM3H5S+YXVjU4HI/ht+10NTjEUf2I9bwRHY/tvBEmAkAwXswcLABAAA=","g27":"H4sIAAAAAAAAE2Ng0HJmYOA5zAAGQc4MDCcOIdgwcS00NrIaGBuqpsHQBa4XzgaqAbPR1SCLo6nBcAOymVjUYDUfl79gdmFRg8v9GH7XQlOPRxzZj1jDE9n92MITYSYAfguvjbABAAA=","g30":"","g24":"","g29":"","g31":"","g32":""},"library":[{"item":"rob4","file":"UR5e.robot","kind":"robot"},{"item":"too5","file":"RobotiQ-2F-85-Gripper-Open.tool","kind":"tool"