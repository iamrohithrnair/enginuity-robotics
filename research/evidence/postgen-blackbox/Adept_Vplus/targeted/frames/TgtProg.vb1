.PROGRAM TgtProg()
  BASE 0,0,0,0
  ; In case of any problems the task will not be stuck forever.
  PARAMETER VTIMEOUT = 5
  ;
  ; Make sure power is enabled
  IF NOT SWITCH(POWER) THEN
  TYPE "Power is not enabled"
  PAUSE
  END
  ;
  ; Robot 1 attached to task
  SELECT ROBOT = 1
  ATTACH ()
  ;
  ; Program generated by RoboDK v6.0.7 for Adept Six 300 on XX/XX/XXXX 18:00:00
  ; Using nominal kinematics.
  SET frame1 = TRANS(1.000,2.000,3.000,-46.333,7.804,50.071)
  ; Optionally create a frame using 4 points
  ;SET frame1 = FRAME(point1x,point2x,pointy,point0)
  ;
  ; Set the tool
  SET tool1 = TRANS(1.000,2.000,3.000,-46.333,7.804,50.071)
  TOOL tool1
  DRIVE 1, 0.000, 25.0
  DRIVE 2, -10.000, 25.0
  DRIVE 3, 20.000, 25.0
  DRIVE 4, 0.000, 25.0
  DRIVE 5, 30.000, 25.0
  DRIVE 6, 0.000, 25.0
  MOVE frame1:TRANS(-607.850,543.849,363.215,-49.279,128.381,-12.253)
  MOVES frame1:TRANS(-607.850,543.849,363.215,-49.279,128.381,-12.253)
  DETACH()
  ;
.END
