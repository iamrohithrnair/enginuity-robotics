.PROGRAM EdgeProg()
  BASE 0,0,0,0
  ; In case of any problems the task will not be stuck forever.
  PARAMETER VTIMEOUT = 5
  ;
  ; Make sure power is enabled
  IF NOT SWITCH(POWER) THEN
  TYPE "Power is not enabled"
  PAUSE
  END
  ;
  ; Robot 1 attached to task
  SELECT ROBOT = 1
  ATTACH ()
  ;
  ; Program generated by RoboDK v6.0.7 for Adept Six 300 on XX/XX/XXXX 18:00:00
  ; Using nominal kinematics.
  SET frame1 = TRANS(100.500,-200.250,300.125,-110.642,35.531,126.052)
  ; Optionally create a frame using 4 points
  ;SET frame1 = FRAME(point1x,point2x,pointy,point0)
  ;
  ; Set the tool
  SET tool1 = TRANS(-1.500,2.250,99.875,90.000,135.000,0.000)
  TOOL tool1
  SPEED 123.5, 100 MMPS ALWAYS
  DRIVE 1, -5.000, 3.1
  DRIVE 2, -5.000, 3.1
  DRIVE 3, 15.000, 3.1
  DRIVE 4, 10.000, 3.1
  DRIVE 5, 40.000, 3.1
  DRIVE 6, -10.000, 3.1
  MOVE frame1:TRANS(-353.026,-90.135,331.702,-17.941,138.234,-12.044)
  MOVES frame1:TRANS(-624.230,571.208,454.620,-37.944,84.814,-45.200)
  PAUSE
  DELAY 1.234
  TYPE "A long message with "quotes", 'apostrophes' & symbols: <>[]{}()=+-*/%;#@! and more text to make it longer than eighty characters"
  ; Comment with ; semicolon
  Gripper=ON
  OUT[12]=FALSE
  Pressure=TRUE
  WAIT FOR PartPresent==TRUE TIMEOUT=250.0
  WAIT FOR IN[7]==1
  DoSomething(12)
  x = 1
  DRIVE 1, 20.000, 3.1
  DRIVE 2, -10.000, 3.1
  DRIVE 3, 20.000, 3.1
  DRIVE 4, 0.000, 3.1
  DRIVE 5, 30.000, 3.1
  DRIVE 6, 0.000, 3.1
  DETACH()
  ;
.END
