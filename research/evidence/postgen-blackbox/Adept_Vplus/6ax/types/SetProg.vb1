.PROGRAM SetProg()
  BASE 0,0,0,0
  ; In case of any problems the task will not be stuck forever.
  PARAMETER VTIMEOUT = 5
  ;
  ; Make sure power is enabled
  IF NOT SWITCH(POWER) THEN
  TYPE "Power is not enabled"
  PAUSE
  END
  ;
  ; Robot 1 attached to task
  SELECT ROBOT = 1
  ATTACH ()
  ;
  ; Program generated by RoboDK v6.0.7 for Adept Six 300 on XX/XX/XXXX 18:00:00
  ; Using nominal kinematics.
  SET frame1 = TRANS(1234.570,-98.765,50.500,0.000,0.000,30.000)
  ; Optionally create a frame using 4 points
  ;SET frame1 = FRAME(point1x,point2x,pointy,point0)
  ;
  ; Set the tool
  SET tool1 = TRANS(10.000,20.000,150.000,0.000,0.000,0.000)
  TOOL tool1
  DRIVE 1, 0.000, 25.0
  DRIVE 2, -10.000, 25.0
  DRIVE 3, 20.000, 25.0
  DRIVE 4, 0.000, 25.0
  DRIVE 5, 30.000, 25.0
  DRIVE 6, 0.000, 25.0
  MOVE frame1:TRANS(-640.584,506.980,371.534,-30.000,130.000,0.000)
  ; Linear movement using joint targets is not supported. Change the target type to cartesian or use a joint movement.
  DRIVE 1, 20.000, 25.0
  DRIVE 2, -10.000, 25.0
  DRIVE 3, 20.000, 25.0
  DRIVE 4, 0.000, 25.0
  DRIVE 5, 30.000, 25.0
  DRIVE 6, 0.000, 25.0
  DELAY 0.250
  DRIVE 1, 30.000, 25.0
  DRIVE 2, -20.000, 25.0
  DRIVE 3, 40.000, 25.0
  DRIVE 4, 60.000, 25.0
  DRIVE 5, -45.000, 25.0
  DRIVE 6, -100.000, 25.0
  MOVE frame1:TRANS(-624.230,571.208,454.620,-37.944,84.814,-45.200)
  DETACH()
  ;
.END
