.PROGRAM PrecProg()
  BASE 0,0,0,0
  ; In case of any problems the task will not be stuck forever.
  PARAMETER VTIMEOUT = 5
  ;
  ; Make sure power is enabled
  IF NOT SWITCH(POWER) THEN
  TYPE "Power is not enabled"
  PAUSE
  END
  ;
  ; Robot 1 attached to task
  SELECT ROBOT = 1
  ATTACH ()
  ;
  ; Program generated by RoboDK v6.0.7 for Adept Cobra s350 on XX/XX/XXXX 18:00:00
  ; Using nominal kinematics.
  SET frame1 = TRANS(0.000,-0.001,1000.000,-89.877,90.000,90.500)
  ; Optionally create a frame using 4 points
  ;SET frame1 = FRAME(point1x,point2x,pointy,point0)
  ;
  ; Set the tool
  SET tool1 = TRANS(0.125,-0.375,123.457,90.000,45.250,-90.000)
  TOOL tool1
  DRIVE 1, 12.346, 25.0
  DRIVE 2, -45.679, 25.0
  DRIVE 3, 78.901, 25.0
  DRIVE 4, -0.500, 25.0
  MOVES frame1:TRANS(-640.585,506.981,371.534,-48.655,128.485,-11.865)
  MOVES frame1:TRANS(0.500,-0.500,0.250,0.005,179.995,180.000)
  DRIVE 1, -12.345, 25.0
  DRIVE 2, 45.678, 25.0
  DRIVE 3, -78.900, 25.0
  DRIVE 4, 0.500, 25.0
  MOVE frame1:TRANS(1500.120,-2000.990,-10.500,0.000,90.000,-0.000)
  DRIVE 1, -12.345, 25.0
  DRIVE 2, 45.678, 25.0
  DRIVE 3, -78.900, 25.0
  DRIVE 4, 0.500, 25.0
  SPEED 66.7, 100 MMPS ALWAYS
  DELAY 0.002
  DELAY 1.000
  MOVES frame1:TRANS(-353.026,-90.135,331.702,-17.941,138.234,-12.044)
  DETACH()
  ;
.END
