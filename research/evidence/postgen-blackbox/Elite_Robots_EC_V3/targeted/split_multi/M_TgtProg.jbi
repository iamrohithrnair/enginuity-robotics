SET B000 1
TIMER T=0.2 S
WAIT B000=0  
MOVL V000 V=100.0 CR=0.0MM ACC=50 DEC=50
MOVL V001 V=100.0 CR=0.0MM ACC=50 DEC=50
MOVL V002 V=100.0 CR=0.0MM ACC=50 DEC=50
END
