$BASE = {FRAME: X 1234.570,Y -98.765,Z 50.500,A 30.000,B 0.000,C 0.000}
; --------------------------
; ---- Setting tool (TCP) ----
$TOOL = {FRAME: X 10.000,Y 20.000,Z 150.000,A 0.000,B 0.000,C 0.000}
; --------------------------
PTP {A1 10.00000,A2 -20.00000,A3 50.00000,A4 0.00000,A5 60.00000,A6 30.00000}
; Linear movement using joint targets is not supported. Change the target type to cartesian or use a joint movement.
; Circular movement using joint targets is not supported. Change the target type to cartesian or use a joint movement.
