&ACCESS RVP
&REL 1
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
&PARAM EDITMASK = *
DEF EdgeProg ( )


; GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
; INTERRUPT ON 3

;FOLD Initialise and set default speed
BAS (#INITMOV,0)
BAS (#VEL_PTP,100)
BAS (#ACC_PTP,20)
$VEL.CP=0.2
BAS (#TOOL,0)
BAS (#BASE,0)
;ENDFOLD

;;FOLD STARTPOS
;$BWDSTART = FALSE
;PDAT_ACT = PDEFAULT
;BAS(#PTP_DAT)
;FDAT_ACT = {TOOL_NO 0,BASE_NO 0,IPO_FRAME #BASE}
;BAS(#FRAMES)
;;ENDFOLD

$ADVANCE = 5

;FOLD ---- Quickly skip BCO ----
; PTP $AXIS_ACT
;ENDFOLD

;FOLD ---- GO HOME ----
; PTP {A1 0.000, A2 -90.000, A3 90.000, A4 0.000, A5 0.000, A6 0.000, E1 0, E2 0, E3 0, E4 0, E5 0, E6 0}
;ENDFOLD


; Program generated by RoboDK v6.0.7 for KUKA IONTEC ultra KR 120 R2700 on XX/XX/XXXX 18:00:00
; Using nominal kinematics.
; ---- Setting reference (Base) ----
$BASE = {FRAME: X 100.500,Y -200.250,Z 300.125,A 10.000,B -20.000,C 30.000}
; --------------------------
; ---- Setting tool (TCP) ----
$TOOL = {FRAME: X -1.500,Y 2.250,Z 99.875,A -90.000,B 45.000,C 180.000}
; --------------------------
$VEL.CP = 0.12346
$VEL.ORI1 = 33.33300
$VEL.ORI2 = 33.33300
PTP {A1 -5.00000,A2 -5.00000,A3 15.00000,A4 10.00000,A5 40.00000,A6 -10.00000}
$APO.CPTP = 12
$APO.CDIS = 12.500
LIN {X -624.230,Y 571.208,Z 454.620,A -122.815,B 44.567,C -82.711} C_DIS
HALT
WAIT SEC 1.234
Wait for StrClear($LOOP_MSG[])
$LOOP_CONT = TRUE
$LOOP_MSG[] = "A long message with "quotes", 'apostrophes' & symbols: <>[]{}()=+-*/%;#@! and more text to make it longer than eighty characters"
; Comment with ; semicolon
Gripper=ON
$OUT[12]=FALSE
Pressure=TRUE
START_TIMER:
$TIMER_STOP[1]=TRUE
$TIMER_FLAG[1]=FALSE
$TIMER[1]=0.250
$TIMER_STOP[1]=FALSE
WAIT FOR (PartPresent==TRUE OR $TIMER_FLAG[1])
$TIMER_STOP[1]=TRUE
IF $TIMER_FLAG[1]== TRUE THEN
    HALT ; Timed out!
    GOTO START_TIMER
ENDIF
WAIT FOR ($IN[7]==1)
Do_Something(1,_2)
x = 1
PTP {A1 20.00000,A2 -10.00000,A3 20.00000,A4 0.00000,A5 30.00000,A6 0.00000} C_PTP
END
