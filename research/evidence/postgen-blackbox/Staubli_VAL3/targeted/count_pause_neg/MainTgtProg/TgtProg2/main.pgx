<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="main">
    <Code><![CDATA[begin
  close(tCurrentTool)
  pPointRx.config.shoulder = lefty
  pPointRx.config.elbow = epositive
  pPointRx.config.wrist = wpositive
  pPointRx2.config.shoulder = lefty
  pPointRx2.config.elbow = epositive
  pPointRx2.config.wrist = wpositive
  mCurrentSpeed.tvel = 100.00
  mCurrentSpeed.blend = joint
  mCurrentSpeed.reach = 0.010
  mCurrentSpeed.leave = 0.010
  popUpMsg("Paused. Press OK to continue")
  call MoveJoint(1.00000,-10.00000,20.00000,0.00000,30.00000,0.00000)
  call MoveJoint(2.00000,-10.00000,20.00000,0.00000,30.00000,0.00000)
  call MoveJoint(3.00000,-10.00000,20.00000,0.00000,30.00000,0.00000)

end]]></Code>
  </Program>
</Programs>