  <Program name="main">
    <Code><![CDATA[begin
  close(tCurrentTool)
  pPointRs.config.shoulder = lefty
  pPointRs2.config.shoulder = lefty
  mCurrentSpeed.tvel = 100.00
  mCurrentSpeed.blend = joint
  mCurrentSpeed.reach = 0.010
  mCurrentSpeed.leave = 0.010
  // Program SetProg start
