PROGRAM LongProg2
VAR
ROUTINE R_LongProg2 EXPORTED FROM LongProg2 GLOBAL

ROUTINE R_LongProg2
VAR
BEGIN
  $ORNT_TYPE := RS_WORLD
  $MOVE_TYPE := JOINT
  $JNT_MTURN := TRUE
  $CNFG_CARE := TRUE
  $TURN_CARE := TRUE
  $SING_CARE := FALSE
  $TERM_TYPE := NOSETTLE
  $FLY_TYPE := FLY_CART
  $FLY_TRAJ := FLY_PASS
  $FLY_DIST := -1.000
  $STRESS_PER:= 65
  MOVE TO {10.00000,-20.00000,50.00000,30.00000}
  MOVE TO {30.00000,25.00000,80.00000,-45.00000}
  MOVE TO {10.00000,-20.00000,50.00000,30.00000}
  MOVE TO {30.00000,25.00000,80.00000,-45.00000}
  MOVE TO {10.00000,-20.00000,50.00000,30.00000}
END R_LongProg

BEGIN
  R_LongProg
END LongProg

