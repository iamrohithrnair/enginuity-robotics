PROGRAM LongProg2
VAR
ROUTINE R_LongProg2 EXPORTED FROM LongProg2 GLOBAL

ROUTINE R_LongProg2
VAR
BEGIN
  $ORNT_TYPE := RS_WORLD
  $MOVE_TYPE := JOINT
  $JNT_MTURN := TRUE
  $CNFG_CARE := TRUE
  $TURN_CARE := TRUE
  $SING_CARE := FALSE
  $TERM_TYPE := NOSETTLE
  $FLY_TYPE := FLY_CART
  $FLY_TRAJ := FLY_PASS
  $FLY_DIST := -1.000
  $STRESS_PER:= 65
  MOVE TO {250.00000}
  MOVE TO {500.00000}
  MOVE TO {250.00000}
  MOVE TO {500.00000}
  MOVE TO {250.00000}
END R_LongProg

BEGIN
  R_LongProg
END LongProg

