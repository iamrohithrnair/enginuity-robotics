Module GModule
  Public prof1 As Profile

  Public Sub Init
    '<MotionProfile>prof1
    prof1 = New Profile
    prof1.Speed = 25
    prof1.Speed2 = 0
    prof1.Accel = 100
    prof1.Decel = 100
    prof1.AccelRamp = 0.1
    prof1.DecelRamp = 0.1
    prof1.Straight = False
    prof1.InRange = 10
    '</MotionProfile>

  End Sub
End Module
