{
  "browser": { "mode": "launch", "executable_path": "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" },
  "start_url": { "url": "https://liquid-glass.glassapp.dev/" },
  "environment": { "viewport": { "width": 1440, "height": 900, "device_scale_factor": 1 }, "color_scheme": "dark", "reduced_motion": "no-preference" },
  "actions": [ { "step_id": "settle", "action": "wait_for_timeout", "duration_ms": 6000 } ],
  "capture": {
    "at_end": ["screenshot", "dom", "url"],
    "network": { "response_body": true },
    "limits": { "max_network_body_bytes": 8388608, "max_network_body_allocation_bytes": 33554432, "max_event_allocation_bytes": 33554432, "max_total_event_allocation_bytes": 268435456 }
  }
}
