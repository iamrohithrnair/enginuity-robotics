{
 "browser": {
  "mode": "launch",
  "executable_path": "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
 },
 "start_url": {
  "url": "https://robodk.com/robotlib/robotlib_app_v3"
 },
 "actions": [
  {
   "step_id": "settle",
   "action": "wait_for_timeout",
   "duration_ms": 9000
  }
 ],
 "capture": {
  "at_end": [
   "url",
   "accessibility"
  ],
  "events": [
   "network",
   "console",
   "page-errors"
  ],
  "network": {
   "request_body": true,
   "response_body": true,
   "header_values": true
  },
  "limits": {
   "max_network_body_bytes": 8388608,
   "max_network_body_allocation_bytes": 33554432,
   "max_event_allocation_bytes": 33554432,
   "max_total_event_allocation_bytes": 268435456
  }
 }
}